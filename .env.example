# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
# From Atlas: Connect → Drivers. Put the database name after ".net/".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skyblue?retryWrites=true&w=majority
# A long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
